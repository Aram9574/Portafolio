# =============================================================================
# Variables de entorno del portafolio. Copia este archivo a .env.local y rellena.
# Ninguna es obligatoria para `yarn dev`, pero sin ellas ciertas funciones fallan.
# =============================================================================

# --- Analítica -------------------------------------------------------------
# Google Analytics 4 Measurement ID.
# Opcional: el sitio ya trae G-TX3LPT5TME cableado por defecto (flujo web de
# alejandrozakzuk.com). Define esta variable solo para usar otro ID.
# analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA_ID=G-TX3LPT5TME

# URL pública del sitio (usada para canonicals/SEO en algunos entornos).
NEXT_PUBLIC_SITE_URL=https://alejandrozakzuk.com

# --- Formulario de contacto (Resend) ---------------------------------------
# Sin RESEND_API_KEY o CONTACT_TO, /api/contact devuelve 500 y no envía correo.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO=tucorreo@ejemplo.com
# Remitente (opcional). Debe ser un dominio verificado en Resend.
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# --- reCAPTCHA v3 (opcional) -----------------------------------------------
# Define AMBAS o NINGUNA. Sin ellas se usan honeypot + rate limit.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# --- Captura de newsletter -------------------------------------------------
# Los suscriptores se guardan en una audiencia de Resend usando la misma
# RESEND_API_KEY de arriba. NO hace falta configurar nada: si esta variable está
# vacía, el sitio busca la audiencia "Portafolio · Newsletter" y la crea si no
# existe. Defínela solo para forzar una audiencia concreta.
# Si la API key no tuviera permiso sobre audiencias, el alta se avisa por email
# a CONTACT_TO para no perder el lead.
RESEND_AUDIENCE_ID=

# Alternativa: webhook n8n/Make. Sin RESEND_AUDIENCE_ID ni esta URL, en
# PRODUCCIÓN /api/newsletter devuelve 503 (no finge éxito); en dev simula éxito.
N8N_WEBHOOK_URL=

# --- PostHog (analítica de producto: heatmaps + repetición de sesión) -------
# El sitio ya trae el project key cableado por defecto. Define estas variables
# solo para usar otro proyecto o host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Consentimiento de marketing por defecto (opcional) --------------------
# 'true' para pre-marcar el consentimiento de marketing. Por defecto vacío/false.
NEXT_PUBLIC_DEFAULT_MARKETING_CONSENT=

# =============================================================================
# SOLO CI / GitHub Actions (NO van en .env.local; se configuran como Secrets
# del repositorio en GitHub → Settings → Secrets and variables → Actions):
#
#   ANTHROPIC_API_KEY    Genera los posts del blog y los borradores de LinkedIn.
#   GMAIL_ADDRESS        Cuenta Gmail que envía el borrador de LinkedIn por email.
#   GMAIL_APP_PASSWORD   App password de esa cuenta (no la contraseña normal).
# =============================================================================
